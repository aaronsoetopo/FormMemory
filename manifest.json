{
  "manifest_version": 3,
  "name": "FormMemory",
  "version": "0.1.0",
  "description": "Remembers what you typed into Google Forms and lets you search it later.",
  "permissions": ["storage"],
  "host_permissions": ["https://docs.google.com/forms/*"],
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["content/capture.js", "content/suggest.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/storage.js", "lib/gemini.js"],
      "matches": ["https://docs.google.com/*"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {}
}
